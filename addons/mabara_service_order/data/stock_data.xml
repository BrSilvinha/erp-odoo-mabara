<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Politica 8: toda salida de materiales se asocia a una Orden de Servicio -->
    <record id="location_consumo_os" model="stock.location">
        <field name="name">Consumo - Ordenes de Servicio</field>
        <field name="usage">customer</field>
    </record>
    <record id="picking_type_despacho_os" model="stock.picking.type">
        <field name="name">Despacho a Orden de Servicio</field>
        <field name="code">outgoing</field>
        <field name="sequence_code">OSOUT</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="location_consumo_os"/>
    </record>
</odoo>
